# ── hermes model provider keys ────────────────────────────────────────────────
# At least one key is required. Uncomment and set the keys for the providers you use.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── dashboard auth ─────────────────────────────────────────────────────────────
# Credentials are stored in nginx/.htpasswd (bcrypt format).
# Generate an entry: htpasswd -bnBC 10 <username> <password>
# Append additional users to the same file for multi-user access.
