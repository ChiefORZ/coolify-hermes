# ── general ───────────────────────────────────────────────────────────────────
# Full public URL of this deployment, including scheme (used by tinyauth for redirects)
HERMES_URL=https://hermes.example.com

# ── tinyauth ─────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies (generate with: openssl rand -hex 32)
TINYAUTH_SECRET=change-me

# Comma-separated list of users in the format username:bcrypt_hash
# Generate a hash: htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
# Example (user "admin" with password "changeme"):
TINYAUTH_USERS=admin:$$2y$$10$$...

# ── hermes model provider keys ────────────────────────────────────────────────
# Uncomment and set the keys for the providers you use
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
